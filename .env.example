# 复制本文件为 .env 后填写。不填则默认用 mock 数据，开箱即用。
PORT=4000

# 每日刷新计划（cron, Asia/Shanghai）。默认每天 10:00。
REFRESH_CRON=0 10 * * *

# 启用的数据源，逗号分隔，按优先级。可选: mock,newrank,weibo
# 例: PROVIDERS=newrank,weibo  （拿不到数据会自动回退 mock）
PROVIDERS=mock

# ── 路径B：第三方数据服务（追踪任意博主的现实方案，需付费签约）──
NEWRANK_API_KEY=
QIANGUA_API_KEY=

# ── 路径A：官方开放平台（热搜榜 + 自有账号）──
WEIBO_ACCESS_TOKEN=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
